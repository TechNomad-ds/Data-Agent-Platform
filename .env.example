# ============================================================
# DataMind Platform - Environment Configuration Template
# 复制本文件为 .env，按需修改
# cp .env.example .env
# ============================================================

# ---------- 数据库 ----------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/data_agent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/data_agent

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ---------- 数据库连接池（按后端 worker 数量计算） ----------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ---------- JWT ----------
SECRET_KEY=please-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 内置管理员账号 ----------
# 首次启动自动创建。务必改成自己的强密码，切勿用默认值或提交真实密码到版本库。
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@datamind.local
ADMIN_PASSWORD=please-change-this-admin-password

# ---------- LLM 配置 ----------
# 后端默认走 Anthropic Claude；要切到 OpenAI 兼容 API，把 LLM_BACKEND 改为 openai 并填下面 OPENAI_*。
LLM_BACKEND=anthropic

# Anthropic (LLM_BACKEND=anthropic 时使用)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=8192
ENABLE_EXTENDED_THINKING=false
ENABLE_PROMPT_CACHING=true

# OpenAI 兼容 (LLM_BACKEND=openai 时使用，可对接 DeepSeek/Qwen/通义/任意中转站)
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------- 检索 ----------
RETRIEVAL_MODE=hybrid       # vector | bm25 | hybrid | multi_query
RRF_K=60
MULTI_QUERY_COUNT=3

# ---------- 知识图谱 ----------
GRAPH_AUTO_EXTRACT=true
GRAPH_MAX_TRIPLES_PER_FILE=50

# ---------- 存储 ----------
STORAGE_ROOT=./storage
CHROMA_PERSIST_DIR=./chroma_data

# ---------- 配额 ----------
DAILY_FREE_CREDITS=20
MAX_CREDITS_PER_RUN=50

# ---------- 并发保护 ----------
MAX_CONCURRENT_STREAMS_PER_USER=3
MAX_CONCURRENT_STREAMS_GLOBAL=24
MAX_PREPROCESSING_TASKS=2
MAX_EMBEDDING_TASKS=2
MAX_OCR_TASKS=2
MAX_GRAPH_TASKS=2

# ---------- 服务 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
FRONTEND_URL=http://localhost:5200
