# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/data_agent
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/data_agent

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT 密钥
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM API 中转站配置
LLM_API_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-api-key
LLM_DEFAULT_MODEL=gpt-4o

# 文件存储根目录
STORAGE_ROOT=./storage

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# 额度配置
DAILY_FREE_CREDITS=100
MAX_CREDITS_PER_RUN=50

# 服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
